{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/rsvp.ts": {
      "maxDuration": 10
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/design-preview",
      "destination": "/index.html"
    },
    {
      "source": "/design-preview/",
      "destination": "/index.html"
    },
    {
      "source": "/thiep-2",
      "destination": "/index.html"
    },
    {
      "source": "/thiep-2/",
      "destination": "/index.html"
    }
  ]
}
